{
	"name": "devto_cli",
	"version": "0.1.0",
	"description": "Command-line client for the dev.to API, with a login",
	"type": "module",
	"license": "MIT",
	"bin": {
		"devto_cli": "./dist/cli.js"
	},
	"exports": {
		".": "./src/index.ts"
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsc -p tsconfig.json && chmod +x ./dist/cli.js",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"dev": "tsx ./src/cli.ts",
		"test": "node --import tsx --test test/*.test.ts"
	},
	"dependencies": {
		"commander": "^12.1.0",
		"zod": "^3.23.8"
	},
	"devDependencies": {
		"@types/node": "^22.10.0",
		"tsx": "^4.19.2",
		"typescript": "^5.6.3"
	}
}
